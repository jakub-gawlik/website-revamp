---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
    gallery: CollectionEntry<"galleries">;
}

const { gallery } = Astro.props;
const { title, description, date, location, cover } = gallery.data;
---

<article
    class="group relative overflow-hidden rounded-lg border border-neutral-200 bg-white transition-shadow hover:shadow-md"
>
    <div class="aspect-4/3 overflow-hidden bg-neutral-100">
        <Image
            src={cover}
            alt={title}
            width={800}
            height={600}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
    </div>
    <div
        class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent"
        aria-hidden="true"
    >
    </div>
    <div class="absolute bottom-0 left-0 right-0 p-5 text-white">
        <div
            class="mb-1 flex items-center gap-2 text-xs font-medium text-white/80"
        >
            {
                location && (
                    <>
                        <span>{location}</span>
                        <span>&middot;</span>
                    </>
                )
            }
            <time datetime={date.toISOString()}>
                {
                    date.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                    })
                }
            </time>
        </div>
        <h3 class="mb-1 text-lg font-semibold">
            <a href={`/galleries/${gallery.id}`} class="hover:underline">
                {title}
            </a>
        </h3>
        <p class="text-sm leading-relaxed text-white/80 line-clamp-2">
            {description}
        </p>
    </div>
</article>
