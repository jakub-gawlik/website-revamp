---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — jacob.dev">
    <div
        class="mx-auto flex max-w-6xl flex-col items-center px-4 py-24 text-center sm:px-6 lg:px-8"
    >
        <h1 class="text-6xl font-bold tracking-tight text-foreground">404</h1>
        <p class="mt-4 text-lg text-foreground/70">
            This page could not be found.
        </p>
        <a
            href="/"
            class="mt-8 rounded-lg bg-pastel-black px-5 py-2.5 text-sm font-medium text-pastel-white transition-colors hover:bg-pastel-black/80"
        >
            Go home
        </a>
    </div>
</BaseLayout>
