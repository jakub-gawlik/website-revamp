---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — jacob.dev">
  <div class="mx-auto flex max-w-6xl flex-col items-center px-4 py-24 text-center sm:px-6 lg:px-8">
    <h1 class="text-6xl font-bold tracking-tight text-neutral-900">404</h1>
    <p class="mt-4 text-lg text-neutral-600">This page could not be found.</p>
    <a
      href="/"
      class="mt-8 rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-neutral-800"
    >
      Go home
    </a>
  </div>
</BaseLayout>
