---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import GalleryCard from "../components/GalleryCard.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const projects = (await getCollection("projects"))
    .filter((p: CollectionEntry<"projects">) => p.data.featured)
    .sort(
        (a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
            b.data.date.getTime() - a.data.date.getTime(),
    )
    .slice(0, 3);

const galleries = (await getCollection("galleries"))
    .filter((g: CollectionEntry<"galleries">) => g.data.featured)
    .sort(
        (a: CollectionEntry<"galleries">, b: CollectionEntry<"galleries">) =>
            b.data.date.getTime() - a.data.date.getTime(),
    )
    .slice(0, 3);

const posts = (await getCollection("posts"))
    .filter((p: CollectionEntry<"posts">) => !p.data.draft)
    .sort(
        (a: CollectionEntry<"posts">, b: CollectionEntry<"posts">) =>
            b.data.date.getTime() - a.data.date.getTime(),
    )
    .slice(0, 3);
---

<BaseLayout title="jacob.dev — Developer, Photographer & Traveller">
    <section class="border-b border-neutral-200 bg-neutral-50">
        <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
            <h1
                class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
            >
                Developer, photographer<br class="hidden sm:block" /> & traveller.
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600">
                I build software, capture moments, and explore the world. This
                site is a home for my projects, photo galleries, and travel
                stories.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
                <a
                    href="/projects"
                    class="rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-neutral-800"
                >
                    View projects
                </a>
                <a
                    href="/galleries"
                    class="rounded-lg border border-neutral-300 bg-white px-5 py-2.5 text-sm font-medium text-neutral-900 transition-colors hover:bg-neutral-50"
                >
                    Browse galleries
                </a>
            </div>
        </div>
    </section>

    {
        projects.length > 0 && (
            <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
                <div class="mb-8 flex items-end justify-between">
                    <h2 class="text-2xl font-bold tracking-tight">
                        Featured projects
                    </h2>
                    <a
                        href="/projects"
                        class="text-sm font-medium text-neutral-600 hover:text-neutral-900"
                    >
                        See all &rarr;
                    </a>
                </div>
                <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {projects.map((project: CollectionEntry<"projects">) => (
                        <ProjectCard project={project} />
                    ))}
                </div>
            </section>
        )
    }

    {
        galleries.length > 0 && (
            <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
                <div class="mb-8 flex items-end justify-between">
                    <h2 class="text-2xl font-bold tracking-tight">
                        Recent galleries
                    </h2>
                    <a
                        href="/galleries"
                        class="text-sm font-medium text-neutral-600 hover:text-neutral-900"
                    >
                        See all &rarr;
                    </a>
                </div>
                <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {galleries.map((gallery: CollectionEntry<"galleries">) => (
                        <GalleryCard gallery={gallery} />
                    ))}
                </div>
            </section>
        )
    }

    {
        posts.length > 0 && (
            <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
                <div class="mb-8 flex items-end justify-between">
                    <h2 class="text-2xl font-bold tracking-tight">
                        Latest travel notes
                    </h2>
                    <a
                        href="/posts"
                        class="text-sm font-medium text-neutral-600 hover:text-neutral-900"
                    >
                        See all &rarr;
                    </a>
                </div>
                <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {posts.map((post: CollectionEntry<"posts">) => (
                        <PostCard post={post} />
                    ))}
                </div>
            </section>
        )
    }
</BaseLayout>
